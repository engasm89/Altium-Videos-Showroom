# Environment variables (optional for static Vite deploy)

# Canonical public URL used for sitemap, robots, Open Graph, and absolute links.
# Default in code/docs: https://learn.eduengteam.com
# Vercel fallback (until Cloudflare DNS is attached):
#   https://eet-electronics-product-dev-library.vercel.app
# VITE_SITE_URL=https://learn.eduengteam.com
# Legacy alias still accepted by import/SEO scripts:
# APP_URL=https://learn.eduengteam.com

# Analytics (no-op if unset)
# VITE_POSTHOG_KEY=phc_xxx
# VITE_GA_ID=G-XXXXXXXX

# Required for production /admin and /feedback-inbox.
# If unset in a PRODUCTION build, those routes are BLOCKED (no empty-password access).
# Local/dev may omit it (admin stays open for convenience).
#
# Vercel setup:
#   1. Project → Settings → Environment Variables
#   2. Add VITE_ADMIN_PASSWORD for Production (+ Preview recommended)
#   3. Redeploy so Vite can bake the value into the client bundle
# Note: Vite VITE_* values are client-visible — this is an access gate, not a server secret.
# VITE_ADMIN_PASSWORD=change-me

# Optional: override feedback POST target (defaults to same-origin /api/feedback)
# VITE_FEEDBACK_ENDPOINT=https://example.com/hooks/eet-feedback
# Optional: operator deep-link shown on /feedback-inbox (GitHub issues / mailbox UI)
# VITE_FEEDBACK_INBOX_URL=https://github.com/org/repo/issues?q=label%3Atutorial-feedback

# Server-only (Vercel Function /api/feedback) — configure at least one delivery backend:
# FEEDBACK_WEBHOOK_URL=https://hooks.example.com/eet-feedback
# RESEND_API_KEY=re_xxx
# FEEDBACK_TO_EMAIL=learn@eduengteam.com
# FEEDBACK_FROM_EMAIL=EET Library Feedback <onboarding@resend.dev>
# GITHUB_TOKEN=ghp_xxx
# GITHUB_FEEDBACK_REPO=owner/repo

# GEMINI_API_KEY: Only needed if you wire AI Studio / Gemini features later.
# GEMINI_API_KEY=
