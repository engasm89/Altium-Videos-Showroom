# Environment variables (optional for static Vite deploy)

# APP_URL: Canonical public URL for the library (used in docs / future absolute links).
# Example after Vercel deploy: https://your-project.vercel.app
APP_URL=

# GEMINI_API_KEY: Only needed if you wire AI Studio / Gemini features later.
# Not required for the current static SPA catalog + learning UX.
# GEMINI_API_KEY=
